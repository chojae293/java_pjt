
public class PrintClass {

	public static void main(String[] args) {
		// TODO Auto-generated method stub
		
		//형식 문자열 출력
		/*
		 * 형석 문자열 출력 이란, 데이터를 출력할 때 특정 형식에 맞춰 출력해야 하는 경우에 사용한다. 
		 * System.out.printf();
		 */
		
		String name = "Mr.Hong";
		
		//이름: Mr. Hong
		System.out.println("이름: " + name);
		System.out.printf("이름: %s\n", name);
		
		/*
		 * "이름: %s" --형식
		 * %s --> 지정자
		 * 
		 * 
		 */
		//이름: 홍길동, 주소: 대전
		String uName = "홍길동";
		String uAddr = "대전";
		System.out.printf("이름: %s, 주소: %s", uName,uAddr);
		System.out.println("이름: " +uName," 주소: " + uAddr);

		
		/*
		 * 지정자 종류
		 * %d      정수형 출력
		 * %f      실수형 출력
		 * %c      문자형 출력
		 * %s      문자열 출력
		 * %b      논리형 출력
		 * 
		 * %o      8진수형 출력
		 * %x      16진수형 출력
		 * 
		 * %n      개행 
		 */
		
		
		System.out.printf("이름: %s, 나이: %d", "홍길동",20);
		System.out.println();
		System.out.printf("결혼유무: %b", false);
		System.out.println();
		System.out.printf("10진수 123 --> 8진수 %o",123);
		System.out.println("+++++");
		
		
		
		
		
	}

}
