import java.util.Scanner;

public class ConditionEX {

	public static void main(String[] args) {
		// TODO Auto-generated method stub
		
		//if 문
		/*
		 * 문법구조
		 * if(조건식){
		 * 	실행문
		 * }
		 */

		
		Scanner scanner = new Scanner(System.in);
		
		int userInputData = new Scanner(System.in);
		
		if (userInputData > 10) {
			System.out.println("userInputData는 10보다 크다.");
		}
		
		if (userInputData == 10) {
			System.out.println("userInputData는 10이다.");
		}
		
		if (userInputData < 10) {
			System.out.println("userInputData는 10보다 작다.");
		}
		
		// if else문 : 양자 택일
		/*
		 * 시험 점수가 70이상이면 '합격' 그렇지 않으면 '불학격'을 출력하자.
		 */
		
		int myScore = scanner.nextInt();
		
		 if (myScore >= 70) {
			 System.out.println("합격!");
		 }else {
			 System.out.println("불학격!");
		 }
		 
		 scanner.close();
		 
		
		
		
		
		
		
		
		
		
	}

}
