package com.office.arrayex;

public class ArrayEx01 {

	public static void main(String[] args) {
		
		//2차원 배열 생성
		int[][] scores = {
				{85, 90, 90},	//1학기 성적들
				{90, 80, 85},	//2학기 성적들
				{90, 90, 100},	//3학기 성적들
				{95, 85, 100}	//4학시 성적들
		};
		
		// for문을 이용한 데이터 조회
		for (int i = 0; i < scores.length; i++) {
			int[] temp = scores[i];
			for(int j = 0; j < temp.length; j++) {
				System.out.println(temp[j]);
			}
		}
	

	}

}
