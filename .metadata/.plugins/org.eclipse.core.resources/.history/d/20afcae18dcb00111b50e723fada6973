
public class Operator2 {

	public static void main(String[] args) {
		
		/*
		 *  1. 대입 연산자 
		 */
		
		
		int no = 10;   // '=' <-- 이녀석을 대입(할당)연산자
		// 대입(할당)연산자란, 오른쪽의 값을 왼쪽의 변수에 대입(할당)하는 연산자 입니다.
		
		// 2. 복합 대입 연산자
		/*
		 * += : 덧셈 후 할당
		 * -= : 뺄샘 후 할당
		 * *= : 곱셉 후 할당
		 * /= : 나눗셈 후 할당
		 * %= : 나머지 연산 후 할당 
		 * 
		 * += no += 10; no에 10을 더한 결과값을 no에 대입한다
		 * -= no -= 10; no에 10을 뺀 결과값을 no에 대입한다
		 * *= no *= 10; no에 10을 곱한 결과값을 no에 대입한다
		 * /= no /= 10; no에 10을 나눈 결과값을 no에 대입한다
		 * %= no %= 10; no에 10을 나눈 나머지 결과값을 no에 대입한다
		 */
		
		// 3. 증강 연산자
		// ++ , --
		no = 10;
		no++;
		System.out.println("no: "+ no);   //11
		
		no--;
		System.out.println("no: "+ no);   //10
		
		// 3.1: 전위 or 후위 연산자
		int num1 = 10;
		int result1 = 0;
		result1 = ++num1;
		System.out.println("result1: "+ result1);
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		

	}

}
